{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "ConnectionString": "amqp://admin:admin@localhost:5672/",
    "InputQueue": "booking-service",
    "DirectExchange": "booking-service-direct",
    "TopicExchange": "booking-service-topics",
    "MessageTypes": {
      "BookingStatusChanged": "BookingService.Events.BookingStatusChangedEvent, BookingService"
    }
  },
  "NotificationService": {
    "BaseUrl": "http://localhost:9000",
    "Retry": {
      "MaxAttempts": 3,
      "DelaySeconds": 1
    }
  },
  "Cache": {
    "StatisticsTtlSeconds": 60
  }
}
